<?xml version="1.0"?>
<!-- Manzana de ~7.5 cm y 150 g (escaneo 013_apple del YCB Object Set, CC BY 4.0). Origen en la base. Colisión: cilindro de pie (una esfera rueda sin fin en la simulación). -->
<sdf version="1.9">
  <model name="apple">
    <link name="link">
      <inertial>
        <pose>0 0 0.037 0 0 0</pose>
        <mass>0.15</mass>
        <inertia><ixx>8.2e-5</ixx><iyy>8.2e-5</iyy><izz>8.2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.070</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>meshes/ycb_apple.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
