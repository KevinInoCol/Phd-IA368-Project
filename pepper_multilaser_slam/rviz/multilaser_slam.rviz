# RViz2 del proyecto IA368, Fase 1: mapa de slam_toolbox + los 3 láseres de Pepper
# (izq. rojo, frontal verde, der. azul) + /pepper/scan_fused (blanco).
# Derivado de pepper_gazebo_plugin/config/pepper_sensors_map.rviz de la base.
Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane Cell Count: 20
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Alpha: 0.8
    Color Scheme: map
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: false
    Marker Scale: 0.3
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /pepper/robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/LaserScan
    Name: Laser_Left
    Enabled: true
    Topic:
      Value: /pepper/scan_left
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.06
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 60; 60
  - Class: rviz_default_plugins/LaserScan
    Name: Laser_Front
    Enabled: true
    Topic:
      Value: /pepper/scan_front
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.06
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 60; 220; 60
  - Class: rviz_default_plugins/LaserScan
    Name: Laser_Right
    Enabled: true
    Topic:
      Value: /pepper/scan_right
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.06
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 60; 140; 255
  - Class: rviz_default_plugins/LaserScan
    Name: Scan_Fused
    Enabled: true
    Topic:
      Value: /pepper/scan_fused
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Size (m): 0.03
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 255; 255
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Topic:
      Value: /pepper/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 50
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
    Covariance:
      Value: false
  - Class: rviz_default_plugins/Odometry
    Name: GroundTruth_Odom
    Enabled: true
    Topic:
      Value: /pepper/odom_groundtruth
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 50
    Shape:
      Value: Arrow
      Color: 0; 200; 0
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
    Covariance:
      Value: false
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 40.0
      X: 0.0
      Y: 2.5
      Angle: 0.0
Window Geometry:
  Width: 1400
  Height: 900
