<?xml version="1.0" ?>
<!-- Sólo la animación de caminar de los actores (walk.dae de Gazebo Classic,
     gazebosim/gazebo-classic, media/models/walk.dae, Apache 2.0). La usan los <actor> de
     museum_with_people_moving.sdf como model://actor_walk/meshes/walk.dae. -->
<model>
  <name>actor_walk</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>Animación walk.dae para actores</description>
</model>
