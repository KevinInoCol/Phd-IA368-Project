<?xml version="1.0"?>
<!-- Copia de citizen_extras_female_03 (port base) con texturas y materiales de nombre único.
     En Harmonic las texturas se cachean por nombre: el original comparte nombres con
     male_03 (Material__1noCulling = cara / camisa) y female_02 (_03_-_Default1noCulling =
     ropa / vestido) y se renderizaba con la camisa a cuadros en la cara y el vestido negro. -->
<model>
 <name>citizen_extras_female_03_fixed</name>
 <version>0.1.0</version>
 <author>
  <name>Jordi Pages</name>
  <email>jordi.page@pal-robotics.com</email>
 </author>
 <sdf version="1.4">model.sdf</sdf>
 <description>
    3D City People - Female 03 - iClone Citizen Extras (texturas renombradas para Harmonic)
 </description>
</model>
